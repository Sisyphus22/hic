{
  "name": "hic-bayeux",
  "productName": "HIC",
  "version": "0.1.2",
  "description": "The Bayeux Tapestry: read the story of 1066, blow it apart and stitch it back, or remix it with captions in 1066 Latin.",
  "author": {
    "name": "Valeria",
    "email": "29075642+Sisyphus22@users.noreply.github.com"
  },
  "homepage": "https://sisyphus22.github.io/hic/",
  "private": true,
  "main": "main.js",
  "scripts": {
    "page": "node scripts/build-page.js",
    "start": "npm run page && electron .",
    "dist": "npm run page && electron-builder --win",
    "dist:mac": "npm run page && electron-builder --mac",
    "dist:linux": "npm run page && electron-builder --linux"
  },
  "build": {
    "appId": "app.hic.bayeux",
    "productName": "HIC",
    "copyright": "Copyright Â© 2026 Valeria. All rights reserved.",
    "artifactName": "HIC-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HIC! Bayeux Tapestry"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "synopsis": "The Bayeux Tapestry, remixed",
      "maintainer": "Valeria <29075642+Sisyphus22@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
